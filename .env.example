NODE_ENV=development

DB_HOST=db
DB_PORT=5432
APP_PORT=3001
JWT_SECRET=
JWT_REFRESH_SECRET=

FRONTEND_URL=http://localhost:5173

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=dawgs

GEMINI_API_KEY=

# Google OAuth client — create one at console.cloud.google.com
# (APIs & Services -> Credentials -> OAuth client ID -> Web application).
# GOOGLE_CALLBACK_URL is where the browser gets redirected back to after
# consent, so it's the same value whether the backend runs in Docker or
# natively (it's what Google redirects the user's browser to, not an
# internal service address).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Use service names (elasticsearch/redis) when running in Docker,
# or localhost when running the backend natively.
ELASTICSEARCH_NODE=http://elasticsearch:9200
REDIS_HOST=redis
REDIS_PORT=6379