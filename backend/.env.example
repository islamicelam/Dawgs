# Override layer for running the backend natively (outside Docker).
# This file is optional and gitignored — only add it if you run
# `npm run start:dev` directly instead of full `docker compose up`.
#
# It only needs the handful of vars that differ between "backend runs
# inside the Docker network" (service names, set in the root .env) and
# "backend runs on the host" (localhost) — everything else (JWT secrets,
# Postgres creds, Gemini/Google keys, etc.) is already covered by the
# root .env, which is loaded as a fallback (envFilePath: ['.env', '../.env']).
DB_HOST=localhost
ELASTICSEARCH_NODE=http://localhost:9200
REDIS_HOST=localhost
